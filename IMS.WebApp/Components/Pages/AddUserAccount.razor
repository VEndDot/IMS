@page "/adduser"
@rendermode InteractiveServer
@inject IAddUserAccountUseCase AddUserAccountUseCase
@inject NavigationManager navigationManager
@inject IJSRuntime JS
<h3>Добавить нового пользователя в систему</h3>
<br />

<EditForm Model="userAccount" OnValidSubmit="OnAddUserAccoun" FormName="AddUserForm">
    <DataAnnotationsValidator></DataAnnotationsValidator>
    <div class="form-group mb-3">
        <label for="name">Имя пользователя</label>
        <InputText id="name" @bind-Value="userAccount.FirstName" class="form-control" placeholder="Введите имя пользователя"></InputText>
        <ValidationMessage For="@(() => userAccount.FirstName)" />
    </div>
    <div class="form-group mb-3">
        <label for="role">Роль пользователя в системе</label>
        <InputSelect id="role" @bind-Value="userAccount.Role" class="form-select">
            <option value="user">user</option>
            <option value="admin">admin</option>
        </InputSelect>
        <ValidationMessage For="@(() => userAccount.Role)" />

        @if (userAccount.Role.Equals("admin"))
        {
            <div class="alert alert-warning mt-2" role="alert">
                ⚠️ <strong>Внимание!</strong> Вы назначаете пользователю полные права администратора.
                Убедитесь, что это доверенное лицо.
            </div>
        }
    </div>

    <div class="form-group mb-3">
        <label for="password">Пароль пользователя в системе</label>
        <InputText id="password" @bind-Value="userAccount.Password" class="form-control" placeholder="Введите пароль пользователя"></InputText>
        <ValidationMessage For="@(() => userAccount.Password)" />
    </div>

    @if (userAccount is not null)
    {
        <div class="card">
            <h5 class="card-header">Предпросмотр:</h5>
            <table class="table">
                <thead>
                    <tr>
                        <th>Имя:</th>
                        <th>Роль:</th>
                        <th>Пароль:</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>@userAccount.FirstName</td>
                        <td>@userAccount.Role</td>
                        <td>@userAccount.Password</td>
                    </tr>
                </tbody>
            </table>

        </div>
    }

    <br />
    <button type="submit" class="btn btn-success">Сохранить</button>
    <button type="button" class="btn btn-primary" @onclick="OnClickCancel" >Выйти</button>
</EditForm>



@code {
    private UserAccount? userAccount; 

    protected override void OnInitialized()
    {
        base.OnInitialized();
        this.userAccount = new UserAccount
        {
            Role = "user"
        };
    }

    private async Task OnAddUserAccoun()
    {
        // Вызывает подтвержедие для пользователя
        var confirmed = await JS.InvokeAsync<bool>("confirm",
            $"Вы действительно хотите создать пользователя {userAccount?.FirstName} c ролью {userAccount?.Role}");
        if (confirmed)
        {
            if (this.userAccount is not null)
            {
                await AddUserAccountUseCase.ExecuteAsync(this.userAccount);
                navigationManager.NavigateTo("/users");
            }
        }

    }

    private void OnClickCancel()
    {
        navigationManager.NavigateTo("/users");
    }
}
