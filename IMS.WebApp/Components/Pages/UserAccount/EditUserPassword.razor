@page "/editpass"
@rendermode InteractiveServer
@using UserAccountModel = IMS.CoreBusiness.Entities.UserAccount
@inject NavigationManager navigationManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IViewUserAccountByIdUseCase ViewUserAccountByIdUseCase
@inject IEditUserAccountPasswordUseCase EditUserAccountPasswordUseCase
@attribute [Authorize(Roles = "admin, user")]

<h3>Измените пароль</h3>

@if (masters != null)
{
    <EditForm Model="masters" OnValidSubmit="OnValidSubmit">
        <div class="form-group mb-3">
            <label>Пароль</label>
            <InputText @bind-Value="masters.Password" class="form-control" />
            <ValidationMessage For="@(() => masters.Password)" />
        </div>
        <div class="form-group mb-3">
            <label>Повторите пароль</label>
            <InputText @bind-Value="secondPass" class="form-control" />
        </div>
        <button type="submit">Изменить</button>
    </EditForm>
}

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert alert-danger">@errorMessage</div>
}


@code {
    // Фильтры
    private int currentMasterId;

    // Данные
    private UserAccountModel? masters = new();

    private string? secondPass;

    // Состояние UI
    private bool isLoading;
    private int? expandedWriteOffId;
    private string? errorMessage;

    protected async override Task OnInitializedAsync()
    {
        await LoadCurrentUserAsync();

    }

    private async Task LoadCurrentUserAsync()
    {
        var autState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = autState.User;
        if (user.Identity?.IsAuthenticated == true)
        {
            var userIdClaim = user.FindFirst("UserId");
            if (userIdClaim is not null)
            {
                currentMasterId = int.Parse(userIdClaim.Value);
                masters = await ViewUserAccountByIdUseCase.ExecuteAsync(currentMasterId);
            }
        }
    }

    private async Task OnValidSubmit()
    {
        if (masters is null)
        {
            errorMessage = "Объект пуст";
            return;
        }    

        if (masters.Password != secondPass)
        {
            errorMessage = "Пароли не равны, повторите ввод!";
        }
        else
        {
            errorMessage = "";
            await EditUserAccountPasswordUseCase.ExecuteAsync(masters);
            navigationManager.NavigateTo("/users");

        }
    }
}
