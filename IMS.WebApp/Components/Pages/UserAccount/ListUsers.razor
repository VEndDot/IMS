@page "/users"
@inject NavigationManager navigationManager
@inject IViewUsersAccountByNameUseCase ViewUsersAccountByNameUseCase
@inject IDeleteUserAccountUseCase DeleteUserAccountUseCase
@rendermode InteractiveServer
@attribute [Authorize(Roles = "admin")]

<h3>Список Пользователей</h3>
<br />
<ViewUserAccountComponent OnSearchUsers="OnSearchUsers"></ViewUserAccountComponent>
<br />

<div class="card h-100">
    <div class="card-body p-10" style="max-height: 60vh; overflow-y: auto;">
        @if (this.usersList is not null)
        {
            <table class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th>Id</th>
                        <th>Имя</th>
                        <th>Роль</th>
                        <th>Пароль</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in usersList)
                    {
                        <tr>
                            <td>@user.Id</td>
                            <td>@user.FirstName</td>
                            <td>@user.Role</td>
                            <td>@user.Password</td>
                            <td><button type="button" class="btn btn-link" @onclick="@(() => OnClickEdit(user.Id))">Изменить</button></td>
                            <td><button type="button" class="btn btn-link" @onclick="@(() => OnClickRemove(user.Id))">Удалить</button></td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>
<br />
<button type="button" class="btn btn-primary" @onclick="AddUserAccount">Добавить нового пользователя</button>

@code {
    private List<UserAccount>? usersList;

    protected override async Task OnInitializedAsync()
    {
        // отображаем список пользователей сразу при загрузки страницы
        var users = await ViewUsersAccountByNameUseCase.ExecuteAsync();
        this.usersList = users.ToList();
    }

    private void OnSearchUsers(List<UserAccount> users)
    {
        this.usersList = users;
    }

    private void AddUserAccount()
    {
        navigationManager.NavigateTo("/adduser");
    }

    private void OnClickEdit(int userId)
    {
        navigationManager.NavigateTo($"/edituser/{userId}");
    }

    private async Task OnClickRemove(int userId)
    {
        await DeleteUserAccountUseCase.ExecuteAsync(userId);
        this.usersList = (await ViewUsersAccountByNameUseCase.ExecuteAsync()).ToList();
    }
}
