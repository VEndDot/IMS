@page "/login"
@inject IMSDbContext IMSContext
@inject NavigationManager navigationManager
@using IMS.Plugins.EFCore.Data
@using IMS.WebApp.ViewModels
@using System.Security.Claims
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Authentication.Cookies

<div class="row">
    <div class="col-lg-4 offset-lg-4 pt-4 pb-4 border">
        <EditForm Model="@Model" OnValidSubmit="Authenticate" FormName="LoginForm">
            <DataAnnotationsValidator></DataAnnotationsValidator>
            <div class="mb-3 text-center flex-column">
                <img src="/WorkingCat.png" style="max-height:20rem; border-radius: 50%" />
                <h3>Авторизация</h3>
            </div>
            <div class="mb-3">
                <label>Имя пользователя</label>
                <InputText @bind-Value="Model.UserName" class="form-control" placeholder="Имя пользователя"/>
                <ValidationMessage For="() => Model.UserName" />
            </div>
            <div class="mb-3">
                <label>Пароль</label>
                <InputText @bind-Value="Model.Password" type="password" class="form-control" placeholder="Пароль"/>
                <ValidationMessage For="() => Model.Password" />
            </div>
            <div class="mb-3 text-center">
                <span class="text-danger">@errorMessage</span>
            </div>
            <div class="mb-3 d-grid gap-2">
                <button type="submit" class="btn btn-primary">Вход в систему</button>
            </div>
        </EditForm>
    </div>
</div>

@code {
    [CascadingParameter]
    public HttpContext? HttpContext { get; set; }

    [SupplyParameterFromForm]
    public LoginViewModel Model { get; set; } = new();

    private string? errorMessage;

    private async Task Authenticate()
    {
        // получаем пользователя
        var userAccount = IMSContext.UserAccounts.Where(x => x.FirstName == Model.UserName).FirstOrDefault();

        // Если пользователя не существует или пароли не совпадают|СООБЩАЕМ!
        if (userAccount is null || userAccount.Password != Model.Password)
        {
            errorMessage = "Неверное имя пользователя или пароль";
            return;
        }

        // список утверждений
        var claims = new List<Claim>
        {
            new Claim(ClaimTypes.Name, Model.UserName), // имя пользователя    
            new Claim(ClaimTypes.Role, userAccount.Role) // роль пользователя
        };

        // Генерируем объект идентификации утверждений
        var identity = new ClaimsIdentity(claims, CookieAuthenticationDefaults.AuthenticationScheme);
        // Создаем принцип утверждения 
        var principal = new ClaimsPrincipal(identity);
        // Вход в принцип
        await HttpContext.SignInAsync(principal);
        navigationManager.NavigateTo("/");
    }
}
