@page "/category"
@inject IViewCategoryByNameUseCase ViewCategoryByNameUseCase
@inject NavigationManager navigationManager
@inject IDeleteCategoryUseCase DeleteCategoryUseCase
@rendermode InteractiveServer

<h3>Список категорий</h3>

<ViewCategoryComponent OnSearchCategory="OnSearchCategory"></ViewCategoryComponent>

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert alert-danger">@errorMessage</div>
}

@if(this.listCategories is not null)
{
    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Название категории</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var category in listCategories)
            {
                <tr>
                    <td>@category.Id</td>
                    <td>@category.Name</td>
                    <td><button @onclick="@(()=>EditCategory(category.Id))" class="btn btn-link">Изменить</button></td>
                    <td><button @onclick="@(() => DeleteCategory(category.Id))" class="btn btn-link">Удалить</button></td>
                </tr>
            }
        </tbody>
    </table>
}

<button type="button" class="btn btn-success" @onclick="AddCategory">Создать категорию</button>

@code {

    private List<Category>? listCategories;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        var category = await ViewCategoryByNameUseCase.ExecuteAsync();
        this.listCategories = category.ToList();
    }

    private void OnSearchCategory(List<Category> categories)
    {
        this.listCategories = categories;      
    }

    private void AddCategory()
    {
        navigationManager.NavigateTo("/addcategory");
    }

    private void EditCategory(int id)
    {
        navigationManager.NavigateTo($"/editcategory/{id}");
    }

    private async Task DeleteCategory(int id)
    {
        try
        {
            await DeleteCategoryUseCase.ExecuteAsync(id);
            listCategories = (await ViewCategoryByNameUseCase.ExecuteAsync()).ToList();
            errorMessage = "";
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }
}
