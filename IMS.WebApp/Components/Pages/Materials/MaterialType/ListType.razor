@page "/type"
@rendermode InteractiveServer
@inject NavigationManager navigationManager
@inject IViewMaterialTypeByNameUseCase ViewMaterialTypeByNameUseCase
@inject IViewCategoryByNameUseCase ViewCategoryByNameUseCase
@inject IViewSubcategoryByIdCategoryUseCase ViewSubcategoryByIdCategoryUseCase
@inject IViewSubcategoryUseCase ViewSubcategoryUseCase
@inject IViewMaterialTypesByIdSubcategoryUseCase ViewMaterialTypesByIdSubcategoryUseCase
@inject IDeleteMaterialTypeUseCase DeleteMaterialTypeUseCase
@attribute [Authorize(Roles = "admin")]

<div div class="row g-3 mb-4">
    <div class="col-md-6 col-lg-4">
    @if (categories is not null)
    {
        <label class="form-label">Категория</label>
        <InputSelect class="form-select" @bind-Value="categoryId" @bind-Value:after="OnCategoryChanged">
            @foreach (var category in categories)
            {
                <option value="@category.Id">@category.Name</option>
            }
        </InputSelect>
    }
    </div>

    <div class="col-md-6 col-lg-4">
        @if (subcategories is not null)
        {
            <label class="form-label">Подкатегория</label>
            <InputSelect class="form-select" @bind-Value="subcategoryId" @bind-Value:after="OnSubcategoryChanged">
                @foreach (var subcategory in subcategories)
                {
                    <option value="@subcategory.Id">@subcategory.Name</option>
                }
            </InputSelect>
        }
    </div>
</div>


<h3>Список типов номенклатуры</h3>
<div class="card h-100">
    <div class="card-body p-10" style="max-height: 60vh; overflow-y: auto;">
        @if (materialTypes is not null)
        {
            <table class="table table-striped table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Id</th>
                        <th>Название типа</th>
                        <th>Описание</th>
                        <th>Id-Подкатегории</th>
                        <th>Подкатегория</th>
                        <th>Id-Категории</th>
                        <th>Категория</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var mType in materialTypes)
                    {
                        <tr>
                            <td>@mType.Id</td>
                            <td>@mType.Name</td>
                            <td>@mType.Description</td>
                            <td>@mType.SubcategoryId</td>
                            <td>@mType.Subcategory?.Name</td>
                            <td>@mType.Subcategory?.CategoryId</td>
                            <td>@mType.Subcategory?.Category?.Name</td>
                            <td><button @onclick="@(() => OnClickEdit(mType.Id))" class="btn btn-link">Изменить</button></td>
                            <td><button @onclick="@(() => OnClickDelete(mType.Id))" class="btn btn-link">Удалить</button></td>
                        </tr>
                    }
                </tbody>

            </table>
        }
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert alert-danger">@errorMessage</div>
}
<br />
<div class="mb-3">
    <button type="button" class="btn btn-success" @onclick="OnClickAddType">
        <i class="fas fa-plus"></i> Добавить тип номенклатуры
    </button>
</div>

@code {

    private List<MaterialType>? materialTypes;

    private List<Category>? categories;
    private int categoryId;

    private List<Subcategory>? subcategories;
    private int subcategoryId;

    private string? errorMessage;

    protected async override Task OnInitializedAsync()
    {
        categories = (await ViewCategoryByNameUseCase.ExecuteAsync()).ToList();

        if (categories.Any())
        {
            categoryId = categories.FirstOrDefault()!.Id;
        }
        await UpdateSubcategoriesAsync();
        await UpdateMaterialTypesAsync();

    }

    private async Task UpdateSubcategoriesAsync()
    {
        if (categoryId <= 0)
        {
            return;
        }

        subcategories = (await ViewSubcategoryByIdCategoryUseCase.ExecuteAsync(categoryId)).ToList();

        if (subcategories.Any())
        {
            subcategoryId = subcategories.First().Id;
        }
        else
        {
            subcategoryId = 0;    
        }

    }

    private async Task UpdateMaterialTypesAsync()
    {
        if (subcategoryId > 0)
        {
            // var all = await ViewMaterialTypeByNameUseCase.ExecuteAsync();
            materialTypes = (await ViewMaterialTypesByIdSubcategoryUseCase.ExecuteAsync(subcategoryId))
                    .ToList();//all.Where(x => x.SubcategoryId == subcategoryId).ToList();
        }
        else
        {
            materialTypes = (await ViewMaterialTypeByNameUseCase.ExecuteAsync()).ToList();
        }
    }

    private async Task OnCategoryChanged()
    {
        await UpdateSubcategoriesAsync();
        await UpdateMaterialTypesAsync();
        errorMessage = "";

    }

    private async Task OnSubcategoryChanged()
    {
        await UpdateMaterialTypesAsync();    
        errorMessage = "";
    }

    private async Task OnClickEdit(int typeId)
    {
        navigationManager.NavigateTo($"/editType/{typeId}");
    }

    private async Task OnClickDelete(int typeId)
    {
        try
        {
            await DeleteMaterialTypeUseCase.ExecuteAsync(typeId);
            await UpdateSubcategoriesAsync();
            await UpdateMaterialTypesAsync();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }

    }

    private void OnClickAddType()
    {
        navigationManager.NavigateTo("/addtype");
    }

}
