@page "/addmaterial"
@rendermode InteractiveServer
@inject NavigationManager navigationManager
@inject IViewCategoryByNameUseCase ViewCategoryByNameUseCase
@inject IViewSubcategoryByIdCategoryUseCase ViewSubcategoryByIdCategoryUseCase
@inject IViewMaterialTypesByIdSubcategoryUseCase ViewMaterialTypesByIdSubcategoryUseCase
@inject IAddMaterialNomenclatureUseCase AddMaterialNomenclatureUseCase
@attribute [Authorize(Roles = "admin")]

<h3>Создать материал (Номенклатура)</h3>

@if (errorMessage is not null)
{
    <div class="alert alert-danger" role="alert">@errorMessage</div>
}

@if (isLoading)
{
    <div class="spinner-border text-primary" role="status"><span class="visually-hidden">Загрузка...</span></div>
}
else if (materialNomenclature is not null)
{
    <EditForm Model="materialNomenclature" OnValidSubmit="OnValidSubmit">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="form-group mb-3">
            @if (categories?.Count > 0)
            {
                <label>Категория</label>
                <InputSelect class="form-select" @bind-Value="categoryId" @bind-Value:after="OnCategoryChanged">
                    @foreach (var cat in categories)
                    {
                        <option value="@cat.Id">@cat.Name</option>
                    }
                </InputSelect>
            }

            @if (subcategories?.Count > 0)
            {
                <label>Подкатегория</label>
                <InputSelect class="form-select" @bind-Value="subcategoryId" @bind-Value:after="OnSubcategoryChanged">
                    @foreach (var sub in subcategories)
                    {
                        <option value="@sub.Id">@sub.Name</option>
                    }
                </InputSelect>
            }

            @if (materialTypes?.Count > 0)
            {
                <label>Тип материала</label>
                <InputSelect class="form-select" @bind-Value="materialTypeId" @bind-Value:after="OnMaterialTypeChanged">
                    @foreach (var type in materialTypes)
                    {
                        <option value="@type.Id">@type.Name</option>
                    }
                </InputSelect>
            }
            else if (materialTypes is not null)
            {
                <div class="text-muted">Для выбранной подкатегории типы не настроены</div>
            }
        </div>

        <div class="form-group mb-3">
            <label>Название</label>
            <InputText class="form-control" @bind-Value="materialNomenclature.Name" />
            <ValidationMessage For="@(() => materialNomenclature.Name)" />
        </div>

        <div class="form-group mb-3">
            <label>Артикул</label>
            <InputText class="form-control" @bind-Value="materialNomenclature.Sku" />
            <ValidationMessage For="@(() => materialNomenclature.Sku)" />
        </div>

        <div class="form-group mb-3">
            <label>ГОСТ</label>
            <InputText class="form-control" @bind-Value="materialNomenclature.Gost" />
            <ValidationMessage For="@(() => materialNomenclature.Gost)" />
        </div>

        <div class="form-group mb-3">
            <label>Сечение</label>
            <InputNumber class="form-control" @bind-Value="materialNomenclature.CrossSection" />
            <ValidationMessage For="@(() => materialNomenclature.CrossSection)" />
        </div>

        <div class="form-group mb-3">
            <label>Единица измерения</label>
            <InputText class="form-control" @bind-Value="materialNomenclature.Unit" />
            <ValidationMessage For="@(() => materialNomenclature.Unit)" />
        </div>

        <div class="form-group mb-3">
            <label>Текущий остаток</label>
            <InputNumber class="form-control" @bind-Value="materialNomenclature.CurrentStock" />
            <ValidationMessage For="@(() => materialNomenclature.CurrentStock)" />
        </div>

        <h4 class="mt-4"><b>Предпросмотр:</b></h4>
        <table class="table table-striped table-sm">
            <thead><tr><th>Поле</th><th>Значение</th></tr></thead>
            <tbody>
                <tr><td>Название</td><td>@materialNomenclature.Name</td></tr>
                <tr><td>Артикул</td><td>@materialNomenclature.Sku</td></tr>
                <tr><td>ГОСТ</td><td>@materialNomenclature.Gost</td></tr>
                <tr><td>Сечение</td><td>@materialNomenclature.CrossSection</td></tr>
                <tr><td>Ед. изм.</td><td>@materialNomenclature.Unit</td></tr>
                <tr><td>Остаток</td><td>@materialNomenclature.CurrentStock</td></tr>
                <tr><td>Тип</td><td>@(materialType?.Name ?? "—")</td></tr>
                <tr><td>Описание</td><td>@(materialType?.Description ?? "—")</td></tr>
                <tr><td>Подкатегория</td><td>@(subcategory?.Name ?? "—")</td></tr>
                <tr><td>Категория</td><td>@(category?.Name ?? "—")</td></tr>
            </tbody>
        </table>

        <button type="submit" class="btn btn-primary">Добавить</button>
        <button type="button" class="btn btn-secondary ms-2" @onclick="OnClickCancel">Отмена</button>
    </EditForm>
}

@code {
    private MaterialNomenclature materialNomenclature = new();
    private bool isLoading = true;
    private string? errorMessage;

    private List<Category>? categories;
    private Category? category;
    private int categoryId;

    private List<Subcategory>? subcategories;
    private Subcategory? subcategory;
    private int subcategoryId;

    private List<MaterialType>? materialTypes;
    private MaterialType? materialType;
    private int materialTypeId;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            categories = (await ViewCategoryByNameUseCase.ExecuteAsync()).ToList();
            if (categories.Any())
            {
                categoryId = categories.First().Id;
                category = categories.First();
                await UpdateSubcategoryAsync();
                await UpdateMaterialTypeAsync();
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Ошибка загрузки справочников: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task UpdateSubcategoryAsync()
    {
        subcategories = (await ViewSubcategoryByIdCategoryUseCase.ExecuteAsync(categoryId)).ToList();
        subcategoryId = subcategories.FirstOrDefault()?.Id ?? 0;
        subcategory = subcategories.FirstOrDefault(s => s.Id == subcategoryId);
    }

    private async Task UpdateMaterialTypeAsync()
    {
        materialTypes = (await ViewMaterialTypesByIdSubcategoryUseCase.ExecuteAsync(subcategoryId)).ToList();
        materialTypeId = materialTypes.FirstOrDefault()?.Id ?? 0;
        materialType = materialTypes.FirstOrDefault(mt => mt.Id == materialTypeId);
    }

    private async Task OnCategoryChanged()
    {
        category = categories?.FirstOrDefault(c => c.Id == categoryId);
        await UpdateSubcategoryAsync();
        await UpdateMaterialTypeAsync();
    }

    private async Task OnSubcategoryChanged()
    {
        subcategory = subcategories?.FirstOrDefault(s => s.Id == subcategoryId);
        await UpdateMaterialTypeAsync();
    }

    private void OnMaterialTypeChanged()
    {
        materialType = materialTypes?.FirstOrDefault(mt => mt.Id == materialTypeId);
    }

    private async Task OnValidSubmit()
    {
        if (materialNomenclature is null) return;

        try
        {
            materialNomenclature.TypeId = materialTypeId;
            materialNomenclature.Type = materialType;

            await AddMaterialNomenclatureUseCase.ExecuteAsync(materialNomenclature);
            navigationManager.NavigateTo("/material");
        }
        catch (Exception ex)
        {
            errorMessage = $"Ошибка сохранения: {ex.Message}";
            StateHasChanged();
        }
    }

    private void OnClickCancel() => navigationManager.NavigateTo("/material");
}