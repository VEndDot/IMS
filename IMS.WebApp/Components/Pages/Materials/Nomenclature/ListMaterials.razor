@page "/material"
@rendermode InteractiveServer
@inject NavigationManager navigationManager
@inject IViewMaterialNomenclatureUseCase ViewMaterialNomenclatureUseCase
@inject IDeleteMaterialNomenclatureUseCase DeleteMaterialNomenclatureUseCase
@attribute [Authorize(Roles = "admin")]

<h3>Список материалов (Номенклатура)</h3>

<div class="d-flex mb-3">
    <div class="input-group">
        <input class="form-control" type="text" placeholder="Поиск материалов..." @bind="searchMaterial" />
        <button type="button" class="btn btn-outline-primary" @onclick="OnClickSearchMaterial">
            <i class="fas fa-search"></i> Поиск
        </button>
    </div>
</div>


<div class="card h-100">
    <div class="card-body p-10">
        @if (materialNomenclatures is not null)
        {
            <div style="max-height: 72vh; overflow-y: auto;">
                <table class="table table-striped table-hover align-middle mb-0">
                    <thead class="table-light sticky-top">
                        <tr>
                            <th>Имя</th>
                            <th>Ариткул</th>
                            <th>Сечение</th>
                            <th>Текущий остаток</th>
                            <th>Единица измерения</th>
                            <th>Тип</th>
                            <th>Описание</th>
                            <th>Подкатегория</th>
                            <th>Категория</th>
                            <th></th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var material in materialNomenclatures)
                        {
                            <tr>
                                <td>@material.Name</td>
                                <td>@material.Sku</td>
                                <td>@material.CrossSection</td>
                                <td><b>@material.CurrentStock</b></td>
                                <td>@material.Unit</td>
                                <td>@material.Type.Name</td>
                                <td>@material.Type.Description</td>
                                <td>@material.Type.Subcategory.Name</td>
                                <td>@material.Type.Subcategory.Category.Name</td>
                                <td>
                                    <button type="button" class="btn btn-link" @onclick="@(() => OnClickEdite(material.Id))">
                                        Редактировать
                                    </button>
                                </td>
                                <td>
                                    <button type="button" class="btn btn-link" @onclick="@(() => OnClickDelete(material.Id))">
                                        Удалить материал
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert alert-warning">@errorMessage</div>
}
<br />
<button type="button" class="btn btn-success" @onclick="OnClickAddMaterial">Добавить материал</button>


@code {

    private List<MaterialNomenclature>? materialNomenclatures;
    private string? searchMaterial;

    private string? errorMessage;

    protected async override Task OnInitializedAsync()
    {
        materialNomenclatures = (await ViewMaterialNomenclatureUseCase.ExecuteAsync()).ToList();
    }

    private async Task OnClickSearchMaterial()
    {
        materialNomenclatures = (await ViewMaterialNomenclatureUseCase.ExecuteAsync(searchMaterial!)).ToList();
    }

    private void OnClickAddMaterial()
    {
        navigationManager.NavigateTo("/addmaterial");
    }

    private async Task OnClickEdite(int materialId)
    {
        navigationManager.NavigateTo($"/editmaterial/{materialId}");
    }

    private async Task OnClickDelete(int materialId)
    {
        try
        {
            await DeleteMaterialNomenclatureUseCase.ExecuteAsync(materialId);
            materialNomenclatures = (await ViewMaterialNomenclatureUseCase.ExecuteAsync()).ToList();
        }
        catch(Exception e)
        {
            errorMessage = e.Message;
        }
    }
}
